{
  "info": {
    "name": "UUON Cloud Security Test Suite",
    "description": "Complete test collection for JWT flow, rate limiting, and audit logging verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Setup (JWT)",
      "description": "Obtain tokens for authenticated tests",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('accessToken', body.accessToken);",
                  "  pm.environment.set('refreshToken', body.refreshToken);",
                  "  pm.test('Login successful', () => pm.expect(pm.response.code).to.equal(200));",
                  "  pm.test('Access token present', () => pm.expect(body.accessToken).to.exist);",
                  "  pm.test('Refresh token present', () => pm.expect(body.refreshToken).to.exist);",
                  "} else {",
                  "  pm.test('Login failed', () => pm.expect(pm.response.code).to.equal(200));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@uuon-foundation.com\",\n  \"password\": \"test-password-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refresh successful', () => pm.expect(pm.response.code).to.be.oneOf([200, 401]));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('accessToken', body.accessToken);",
                  "  pm.test('New access token issued', () => pm.expect(body.accessToken).to.exist);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout returns success or 401', () => pm.expect(pm.response.code).to.be.oneOf([200, 401]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Rate Limiting Tests",
      "description": "Test all 7 rate limiters by hitting them 6+ times",
      "item": [
        {
          "name": "Global Limiter (6+ requests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 429) {",
                  "  pm.test('Rate limit triggered on request 6', () => pm.expect(pm.response.code).to.equal(429));",
                  "} else {",
                  "  pm.test('Response received', () => pm.expect([200, 401, 400]).to.include(pm.response.code));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "metrics"
              ]
            }
          }
        },
        {
          "name": "API Limiter (6+ requests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API endpoint responds', () => pm.expect(pm.response.code).to.be.oneOf([200, 429]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conversations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations"
              ]
            }
          }
        },
        {
          "name": "Auth Limiter (6+ login attempts)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 429) {",
                  "  pm.test('Auth rate limit triggered', () => pm.expect(pm.response.code).to.equal(429));",
                  "  pm.test('Rate limit message present', () => pm.expect(pm.response.text()).to.include('Rate limit'));",
                  "} else {",
                  "  pm.test('Auth endpoint responds', () => pm.expect([200, 400, 500]).to.include(pm.response.code));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ratelimit@test.com\",\n  \"password\": \"wrong\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Chat Limiter (6+ messages)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Chat endpoint responds or rate limited', () => pm.expect(pm.response.code).to.be.oneOf([200, 429, 400]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Test message\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations/1/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "1",
                "messages"
              ]
            }
          }
        },
        {
          "name": "Upload Limiter (6+ uploads)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Upload endpoint responds', () => pm.expect([200, 400, 429]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "value": "test file content",
                  "type": "text"
                },
                {
                  "key": "conversationId",
                  "value": "1",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "upload"
              ]
            }
          }
        },
        {
          "name": "Scrape Limiter (6+ scrapes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Scrape endpoint responds', () => pm.expect([200, 400, 429]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://uuon-foundation.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/scrape",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "scrape"
              ]
            }
          }
        },
        {
          "name": "Ingest Limiter (6+ ingests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ingest endpoint responds', () => pm.expect([200, 400, 429]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"chat history\",\n  \"source\": \"chatgpt\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/uinverse/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "uinverse",
                "ingest"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Audit Logging Verification",
      "description": "Verify audit logs capture all requests correctly",
      "item": [
        {
          "name": "Check Metrics (request count)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Metrics endpoint returns data', () => pm.expect(pm.response.code).to.equal(200));",
                  "const body = pm.response.json();",
                  "pm.test('totalRequests tracked', () => pm.expect(body.totalRequests).to.be.above(0));",
                  "pm.test('avgResponseTime recorded', () => pm.expect(body.avgResponseTime).to.be.above(0));",
                  "pm.test('Response history captured', () => pm.expect(body.responseTimeHistory).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "metrics"
              ]
            }
          }
        },
        {
          "name": "Check Health (system status)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Health check successful', () => pm.expect(pm.response.code).to.equal(200));",
                  "const body = pm.response.json();",
                  "pm.test('Status operational', () => pm.expect(body.status).to.equal('operational'));",
                  "pm.test('Database connected', () => pm.expect(['connected', 'disconnected']).to.include(body.components.database.status));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "Get Access Log",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Access log retrieved', () => pm.expect(pm.response.code).to.be.oneOf([200, 401]));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Log is array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/access-log",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "access-log"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Security Headers Validation",
      "description": "Verify security headers are present",
      "item": [
        {
          "name": "Check Security Headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CSP header present', () => pm.expect(pm.response.headers.has('content-security-policy')).to.be.true);",
                  "pm.test('HSTS header present', () => pm.expect(pm.response.headers.has('strict-transport-security')).to.be.true);",
                  "pm.test('X-Frame-Options header present', () => pm.expect(pm.response.headers.has('x-frame-options')).to.be.true);",
                  "pm.test('Referrer-Policy header present', () => pm.expect(pm.response.headers.has('referrer-policy')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ]
}

#!/bin/bash

# CLOUUD Interactive Terminal CLI
# Direct interface to local CLOUUD agent without curl complexity

set -e

# Color codes
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# API Base URL
API="http://localhost:5001/api"
CURRENT_CONV_ID=""

# Functions
show_menu() {
  echo ""
  echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║      CLOUUD TERMINAL AGENT CLI         ║${NC}"
  echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
  echo ""
  echo "1) New conversation"
  echo "2) Send message"
  echo "3) View conversation"
  echo "4) List all conversations"
  echo "5) Search GitHub repos"
  echo "6) Check system status"
  echo "7) View audit log"
  echo "8) Register credit"
  echo "9) Log JUNO transaction"
  echo "0) Exit"
  echo ""
}

new_conversation() {
  read -p "Conversation title: " title
  
  RESULT=$(curl -s -X POST "$API/conversations" \
    -H "Content-Type: application/json" \
    -d "{\"title\":\"$title\"}")
  
  CURRENT_CONV_ID=$(echo $RESULT | jq '.id' 2>/dev/null || echo "0")
  
  if [ "$CURRENT_CONV_ID" != "0" ]; then
    echo -e "${GREEN}✅ Created${NC} - Conversation ID: $CURRENT_CONV_ID"
  else
    echo -e "${RED}❌ Failed${NC}"
  fi
}

send_message() {
  if [ -z "$CURRENT_CONV_ID" ] || [ "$CURRENT_CONV_ID" = "" ]; then
    read -p "Conversation ID: " CURRENT_CONV_ID
  fi
  
  echo -e "${YELLOW}Type your message (Ctrl+D to send):${NC}"
  MESSAGE=$(cat)
  
  echo "Sending..."
  
  RESULT=$(curl -s -X POST "$API/conversations/$CURRENT_CONV_ID/messages" \
    -H "Content-Type: application/json" \
    -d "{\"content\":$(echo "$MESSAGE" | jq -Rs .)}")
  
  RESPONSE=$(echo $RESULT | jq -r '.assistantMessage.content' 2>/dev/null)
  
  if [ ! -z "$RESPONSE" ] && [ "$RESPONSE" != "null" ]; then
    echo ""
    echo -e "${GREEN}CLOUUD:${NC}"
    echo "$RESPONSE"
    echo ""
  else
    echo -e "${RED}Error getting response${NC}"
    echo $RESULT | jq '.'
  fi
}

view_conversation() {
  if [ -z "$CURRENT_CONV_ID" ]; then
    read -p "Conversation ID: " CURRENT_CONV_ID
  fi
  
  RESULT=$(curl -s "$API/conversations/$CURRENT_CONV_ID/messages")
  COUNT=$(echo $RESULT | jq 'length' 2>/dev/null || echo "0")
  
  echo -e "${BLUE}Conversation #$CURRENT_CONV_ID ($COUNT messages)${NC}"
  echo ""
  
  echo $RESULT | jq -r '.[] | "\(.role | ascii_upcase): \(.content[:100])"' | head -20
}

list_conversations() {
  RESULT=$(curl -s "$API/conversations")
  
  echo -e "${BLUE}Your Conversations:${NC}"
  echo ""
  
  echo $RESULT | jq -r '.[] | "ID: \(.id) | \(.title) | \(.createdAt[:10])"'
}

search_repos() {
  read -p "Search term: " query
  
  RESULT=$(curl -s "$API/sync/github/search?q=$query")
  COUNT=$(echo $RESULT | jq '.count' 2>/dev/null || echo "0")
  
  echo -e "${BLUE}Found $COUNT files${NC}"
  echo ""
  
  echo $RESULT | jq -r '.results[] | "\(.repoName)/\(.filePath)"' | head -10
}

check_status() {
  RESULT=$(curl -s "$API/health")
  STATUS=$(echo $RESULT | jq -r '.status' 2>/dev/null)
  DB=$(echo $RESULT | jq -r '.components.database.status' 2>/dev/null)
  
  echo -e "${BLUE}System Status${NC}"
  echo "API: $STATUS"
  echo "Database: $DB"
  echo ""
  
  CONVS=$(curl -s "$API/conversations" | jq 'length' 2>/dev/null || echo "0")
  CREDITS=$(curl -s "$API/credits/all" 2>/dev/null | jq '.total' || echo "0")
  REPOS=$(curl -s "$API/sync/github/stats" 2>/dev/null | jq '.repos' || echo "0")
  
  echo "Conversations: $CONVS"
  echo "Credits tracked: $CREDITS"
  echo "GitHub repos: $REPOS"
}

view_audit() {
  RESULT=$(curl -s "$API/audit-log?hours=1")
  COUNT=$(echo $RESULT | jq '.count' 2>/dev/null || echo "0")
  
  echo -e "${BLUE}Recent Activity (Last Hour) - $COUNT events${NC}"
  echo ""
  
  echo $RESULT | jq -r '.entries[-10:] | reverse[] | "\(.timestamp[:19]) | \(.tool) | \(.action)"'
}

register_credit() {
  read -p "Service (e.g., blockdaemon): " service
  read -p "Name: " name
  read -p "Quantity: " qty
  read -p "Unit (e.g., API calls): " unit
  read -p "Expires (e.g., 2026-08-12): " expires
  
  RESULT=$(curl -s -X POST "$API/credits/register" \
    -H "Content-Type: application/json" \
    -d "{
      \"service\":\"$service\",
      \"credentialType\":\"credits\",
      \"name\":\"$name\",
      \"quantity\":$qty,
      \"unit\":\"$unit\",
      \"expiresAt\":\"${expires}T00:00:00Z\"
    }")
  
  ID=$(echo $RESULT | jq -r '.account.id' 2>/dev/null)
  
  if [ ! -z "$ID" ] && [ "$ID" != "null" ]; then
    echo -e "${GREEN}✅ Registered${NC} - ID: $ID"
  else
    echo -e "${RED}❌ Failed${NC}"
  fi
}

log_transaction() {
  read -p "Asset (e.g., JUNO): " asset
  read -p "Amount: " amount
  read -p "From: " from
  read -p "To: " to
  read -p "Transaction hash: " txhash
  
  RESULT=$(curl -s -X POST "$API/blockchain/transaction" \
    -H "Content-Type: application/json" \
    -d "{
      \"type\":\"purchase\",
      \"asset\":\"$asset\",
      \"amount\":\"$amount\",
      \"source\":\"$from\",
      \"destination\":\"$to\",
      \"txHash\":\"$txhash\"
    }")
  
  ID=$(echo $RESULT | jq -r '.transaction.id' 2>/dev/null)
  
  if [ ! -z "$ID" ] && [ "$ID" != "null" ]; then
    echo -e "${GREEN}✅ Logged${NC} - TX ID: $ID"
  else
    echo -e "${RED}❌ Failed${NC}"
  fi
}

# Main loop
while true; do
  show_menu
  read -p "Select option (0-9): " choice
  
  case $choice in
    1) new_conversation ;;
    2) send_message ;;
    3) view_conversation ;;
    4) list_conversations ;;
    5) search_repos ;;
    6) check_status ;;
    7) view_audit ;;
    8) register_credit ;;
    9) log_transaction ;;
    0) echo "Goodbye"; exit 0 ;;
    *) echo "Invalid option" ;;
  esac
  
  read -p "Press Enter to continue..."
done

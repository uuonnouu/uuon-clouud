# CLOUUD Environment Variables
NODE_ENV=production
PORT=5001

# Database
DATABASE_URL=postgresql://clouud:clouud@db:5432/clouud?sslmode=disable
DB_PASSWORD=clouud

# AI Backend
AI_BACKEND=ollama
OLLAMA_MODEL=clouud:latest
OLLAMA_HOST=http://host.docker.internal:11434/v1
OPENROUTER_API_KEY=

# Blockdaemon Integration
BLOCKDAEMON_API_KEY=
BLOCKDAEMON_API_SECRET=
BLOCKDAEMON_BASE_URL=https://api.blockdaemon.com
BLOCKDAEMON_NETWORK=juno
BLOCKDAEMON_VALIDATOR_ADDRESS=

# Security
UUON_BRIDGE_SECRET=localdev

# Dmension Bridge
DMENSION_API_URL=https://uuon-foundation.com

# Optional: Sketchfab backup
SKETCHFAB_API_TOKEN=

# Node.js
node_modules/
dist/
build/
*.tsbuildinfo

# Environment & secrets (NEVER commit)
.env
.env.local
.env.*.local
.env.production

# Dependencies
yarn.lock
pnpm-lock.yaml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Runtime
tmp/
temp/
.cache/
.DS_Store
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.vs/

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/

# Docker (keep compose files, exclude volumes)
.docker/

# Uploads (keep but exclude huge files)
uploads/*
!uploads/.gitkeep

# Generated images
generated_images/*
!generated_images/.gitkeep

# Database backups (keep latest, exclude others from repo)
backups/*.sql.gz
!backups/.gitkeep

# Replit
.replit
.upm/

# Keep these for recovery:
!.env.example
!backups/
!FILES.sha256

!clouud-observer/logs
!clouud-observer/logs/**
backups/
*.db


# Database Configuration (REQUIRED for token/energy system)
DATABASE_URL="postgresql://username:password@host:port/database"

# Development Note: 
# - Production automatically sets DATABASE_URL
# - Development requires manual setup
# - Without DATABASE_URL, token system runs in simulation mode

# Token Security (REQUIRED for production)
UUON_TOKEN_SECRET="your-secure-secret-key-here"

# API Keys (Optional)
OPENAI_API_KEY="your-openai-key"
RUFLO_SECRET_KEY="your-anthropic-key"
IBM_QUANTUM_TOKEN="your-ibm-quantum-token"

# Development Settings
NODE_ENV=development
PORT=5000
